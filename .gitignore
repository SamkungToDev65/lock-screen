# ==========================================
# SAMMLocker .gitignore
# ==========================================

# 1. Sensitive Credentials & Server Configs (ป้องกันรหัสผ่านเซิร์ฟเวอร์รั่วไหล)
server/config.php
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key

# 2. Node Dependencies
node_modules/
.pnp
.pnp.js

# 3. Production Build Outputs (Vercel จะ build เองอัตโนมัติ)
dist/
dist-ssr/
build/
*.local

# 4. Vercel Metadata & Cache
.vercel/

# 5. Logs & Temporary Debug Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Editor & IDE Directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 7. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

